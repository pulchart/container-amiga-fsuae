{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:all"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "FEDORA_VERSION, AROS_COMMIT and APOLLOOS_COMMIT in the Containerfile",
      "managerFilePatterns": [
        "/^Containerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\nARG \\w+=(?<currentValue>\\S+)",
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)\\nARG \\w+=(?<currentDigest>[0-9a-f]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "Lint tool images run in the workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/.+\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>(?:docker|ghcr)\\.io/[^:\\s\"]+):(?<currentValue>v?\\d[^\\s\"]*)"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Fedora releases come from endoflife.date, the image tags also have prereleases",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "registry.fedoraproject.org/fedora"
      ],
      "enabled": false
    },
    {
      "description": "The AROS and ApolloOS builds stay on Ubuntu 22.04",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "docker.io/library/ubuntu",
        "ubuntu"
      ],
      "enabled": false
    }
  ],
  "schedule": [
    "after 4am and before 8am"
  ],
  "timezone": "UTC"
}
